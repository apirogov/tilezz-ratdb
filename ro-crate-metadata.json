      "@type": [
        "File",
        "CreativeWork"
      ],
      "contentSize": "3215",
      "description": "Length-prefix convention used inside the DAFSA's accepted sequences: stored_sequence = [len, rat...].",
      "encodingFormat": "text/plain",
